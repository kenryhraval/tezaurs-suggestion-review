# kopīgi iestatījumi visām vidēm
DB_URL=postgres://tezaurs:replace-with-a-database-password@localhost:5432/tezaurs_suggestions
GEMINI_API_KEY=replace-with-a-gemini-api-key
GROQ_API_KEY=replace-with-a-groq-api-key
MODEL_MAX_SELECTED_EXAMPLES=200
MODEL_MAX_INPUT_CHARACTERS=250000
SUGGESTIONS_IMPORT_DELAY_MS=10000

# lokālajai un atsevišķā servera videi
POSTGRES_DB=tezaurs_suggestions
POSTGRES_USER=tezaurs
POSTGRES_PASSWORD=replace-with-a-database-password
TEZAURS_DICT_DUMP=/absolute/path/to/dictionary.pgsql.gz
TEZAURS_SUGGESTIONS_DUMP=/absolute/path/to/suggestions.pgsql.gz

# atsevišķā servera videi
APP_DOMAIN=tip.example.com
BASIC_AUTH_USER_1=editor
BASIC_AUTH_PASSWORD_HASH_1='replace-with-a-caddy-password-hash'
BASIC_AUTH_USER_2=reviewer
BASIC_AUTH_PASSWORD_HASH_2='replace-with-a-caddy-password-hash'

# produkcijas videi
PORT=8081
